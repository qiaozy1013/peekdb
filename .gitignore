# --- Build artifacts ---
/bin/
/dist/
/out/
/peekdb
/peekdb-mut
/peekdb.exe
/peekdb-mut.exe
*.exe
*.dll
*.so
*.dylib

# --- Go test cache (left over from an earlier Defender
#     workaround; the current setup uses GOTMPDIR, see
#     Taskfile.yml) ---
/.gocache/

# --- Test artifacts ---
*.test
*.out
coverage.txt
coverage.html
*.coverprofile

# --- Go workspace files ---
go.work
go.work.sum

# --- Vendor (if used) ---
/vendor/

# --- IDE / editor ---
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# --- OS files ---
.DS_Store
desktop.ini
ehthumbs.db
ehthumbs_vista.db
.Trash-*

# --- Logs and temp ---
*.log
*.tmp
*.temp
# Keep LevelDB data files (e.g. 000001.log) — they look like logs but
# are SSTable/memtable records. Without this, every leveldb fixture
# directory would commit only CURRENT/LOCK/LOG/MANIFEST and the tests
# would iterate over an empty database on CI runners.
!/testdata/leveldb/**/*.log

# --- Local config ---
.env
.env.local
config.local.yaml
config.local.toml

# --- Generated docs ---
/docs/_build/
/docs/site/
/public/

# --- Real test data (NEVER commit) ---
# Real Chrome History, VSCode state, etc.
# Only mock data under testdata/ should be committed.
/testdata/real/
/testdata/.cache/
/testdata/tmp/

# --- TUI session temp files ---
# Copy-on-open creates temp files; they should be cleaned up but just in case
/tmp/peekdb-*/

# --- Profiling ---
*.prof
*.pprof
pprof.data
.gotmp/
