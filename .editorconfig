# EditorConfig is awesome: https://EditorConfig.org
# Top-most EditorConfig file. Per-directory overrides may follow.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab
indent_size = 4

[*.{yml,yaml,json,toml}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
# Markdown lists often need a trailing space; leave them alone.

[Makefile]
indent_style = tab
